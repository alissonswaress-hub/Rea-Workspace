{
  "name": "REA Workspace",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    }
  },
  "postCreateCommand": "npm install --global rea-agents@6.9.0",
  "remoteUser": "vscode",
  "forwardPorts": [
    3000,
    4173,
    4174
  ],
  "portsAttributes": {
    "3000": {
      "label": "REA Hub • Acesso privado pelo celular",
      "onAutoForward": "openBrowser"
    },
    "4173": {
      "label": "TreinoLab (web app de treino)",
      "onAutoForward": "notify"
    },
    "4174": {
      "label": "Prévia privada • aplicativos gerados pelo Copilot",
      "onAutoForward": "notify",
      "visibility": "private"
    }
  },
  "postStartCommand": "bash scripts/rea-hub-mobile.sh"
}
